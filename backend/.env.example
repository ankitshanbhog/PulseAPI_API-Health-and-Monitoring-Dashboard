PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_for_api_monitoring_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Configuration
# If connecting to local or docker PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/api_monitoring
PGUSER=postgres
PGHOST=localhost
PGDATABASE=api_monitoring
PGPASSWORD=postgres
PGPORT=5432

# Automated Health Checks Schedule (cron syntax)
DEFAULT_CHECK_INTERVAL_CRON=* * * * *
